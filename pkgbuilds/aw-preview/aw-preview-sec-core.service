# Optional dedicated Preview backend; never enabled by package installation.
[Unit]
Description=AW Preview sec-core backend
After=local-fs.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=root
Group=root
ExecStart=@PREFIX@/libexec/aw/providers/sec-core/agent-sec-daemon serve --socket /run/aw-preview-sec-core/daemon.sock --skillsec-config /usr/share/aw-preview/skillsec.json
Environment=AGENT_SEC_DATA_DIR=/var/lib/aw-preview-sec-core
Environment=OTEL_SDK_DISABLED=true
RuntimeDirectory=aw-preview-sec-core
RuntimeDirectoryMode=0755
# Keep the lock inode across stop/restart. The daemon safely reclaims stale sockets.
RuntimeDirectoryPreserve=yes
UMask=0077
StateDirectory=aw-preview-sec-core
StateDirectoryMode=0700
LogsDirectory=aw-preview-sec-core
LogsDirectoryMode=0700
Restart=on-failure
RestartSec=2
# 2s UDS drain + 65s shared background drain + 1s Tokio shutdown
# + 5s final database maintenance + 2s telemetry shutdown.
TimeoutStopSec=75
KillSignal=SIGTERM
KillMode=control-group
SendSIGKILL=yes
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
SystemCallFilter=@system-service
SystemCallArchitectures=native
MemoryDenyWriteExecute=true
# Scope discovery needs ptrace read access to procfs exe and namespace links across UIDs.
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_CHOWN CAP_FOWNER CAP_SYS_PTRACE
AmbientCapabilities=
# Skills may live in users' HOME, /tmp, /usr/share or mounted SkillFS trees.
# These paths must remain visible and writable for scanning, publication and rollback.
PrivateTmp=false
ProtectSystem=false
ProtectHome=false
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
