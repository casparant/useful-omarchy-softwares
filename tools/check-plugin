#!/usr/bin/env python3
"""Validate public plugin sources; optionally require Omarchy's official validator."""
import argparse
import subprocess
import sys
from plugin_lib import ROOT, check, load_catalog, select_plugin


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("plugins", nargs="*", help="public plugin folder names (default: all)")
    parser.add_argument("--require-omarchy", action="store_true")
    args = parser.parse_args()
    entries = load_catalog()
    names = args.plugins or [entry["path"].split("/")[1] for entry in entries]
    if not names:
        raise ValueError("no public plugins found")
    for name in names:
        directory, entry = select_plugin(name)
        detail = check(directory, entry, args.require_omarchy)
        print("{}: OK ({})".format(name, detail))


if __name__ == "__main__":
    try:
        main()
    except (ValueError, OSError, KeyError, SyntaxError, subprocess.CalledProcessError) as error:
        sys.exit("check-plugin: " + str(error))
